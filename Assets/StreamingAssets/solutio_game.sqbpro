id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="60"/><column index="2" value="52"/><column index="3" value="70"/><column index="4" value="74"/><column index="5" value="82"/><column index="6" value="76"/><column index="7" value="31"/><column index="8" value="46"/><column index="9" value="46"/><column index="10" value="75"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="sqlite_sequence" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="54"/><column index="2" value="29"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="users" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="50"/><column index="2" value="36"/><column index="3" value="95"/><column index="4" value="39"/><column index="5" value="68"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">-- Включаем поддержку внешних ключей
PRAGMA foreign_keys = ON;

-- СБРАСЫВАЕМ СТАРЫЕ ТАБЛИЦЫ ДЛЯ ЧИСТОГО СТАРТА
DROP TABLE IF EXISTS match_history;
DROP TABLE IF EXISTS items;
DROP TABLE IF EXISTS heroes;
DROP TABLE IF EXISTS users;

-- 1. ТАБЛИЦА ПОЛЬЗОВАТЕЛЕЙ (users)
CREATE TABLE users (
    id_user INTEGER PRIMARY KEY AUTOINCREMENT,
    login TEXT NOT NULL UNIQUE,
    password_hash TEXT NOT NULL,
    email TEXT NOT NULL UNIQUE,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
);

-- 2. ТАБЛИЦА ГЕРОЕВ (heroes)
-- Роли: 'Tank', 'Carry', 'Support'
CREATE TABLE heroes (
    id_hero INTEGER PRIMARY KEY AUTOINCREMENT,
    hero_name TEXT NOT NULL UNIQUE,
    hero_role TEXT NOT NULL CHECK(hero_role IN ('Tank', 'Carry', 'Support')),
    base_attack INTEGER NOT NULL CHECK(base_attack &gt;= 0),
    base_armor INTEGER NOT NULL CHECK(base_armor &gt;= 0),
    base_hp INTEGER NOT NULL CHECK(base_hp &gt; 0)
);

-- 3. ТАБЛИЦА ПРЕДМЕТОВ (items)
-- Типы: 'Free' (стартовые, 0g), 'Shop' (магазин)
-- Редкости: 'Common', 'Rare', 'Epic', 'Legendary'
CREATE TABLE items (
    id_item INTEGER PRIMARY KEY AUTOINCREMENT,
    item_name TEXT NOT NULL UNIQUE,
    item_type TEXT NOT NULL CHECK(item_type IN ('Free', 'Shop')),
    rarity TEXT NOT NULL CHECK(rarity IN ('Common', 'Rare', 'Epic', 'Legendary')),
    bonus_attack INTEGER NOT NULL DEFAULT 0,
    bonus_armor INTEGER NOT NULL DEFAULT 0,
    bonus_hp INTEGER NOT NULL DEFAULT 0,
    cost INTEGER NOT NULL DEFAULT 0 CHECK(cost &gt;= 0)
);

-- 4. ТАБЛИЦА ИСТОРИИ МАТЧЕЙ (match_history)
CREATE TABLE match_history (
    id_match INTEGER PRIMARY KEY AUTOINCREMENT,
    id_user INTEGER NOT NULL,
    map_name TEXT NOT NULL,
    ai_difficulty TEXT NOT NULL,
    match_result TEXT NOT NULL,
    total_points INTEGER NOT NULL DEFAULT 0,
    kills INTEGER NOT NULL DEFAULT 0,
    deaths INTEGER NOT NULL DEFAULT 0,
    assists INTEGER NOT NULL DEFAULT 0,
    match_date DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_user) REFERENCES users(id_user) ON DELETE CASCADE
);

-- ИНДЕКСЫ ДЛЯ МОЛНИЕНОСНЫХ ВЫБОРОК НА 360+ FPS
CREATE INDEX idx_match_history_user ON match_history(id_user);
CREATE INDEX idx_match_history_points ON match_history(total_points DESC);
CREATE INDEX idx_heroes_role ON heroes(hero_role);
CREATE INDEX idx_items_type_rarity ON items(item_type, rarity);

-- ==========================================
-- ЗАПОЛНЕНИЕ: 10 ПЕРСОНАЖЕЙ (3 РОЛИ)
-- ==========================================

-- ТАНКИ (3 чемпиона)
