ings (
    id_user        INTEGER PRIMARY KEY,
    ai_difficulty  TEXT    NOT NULL DEFAULT 'Normal'
                   CHECK(ai_difficulty IN ('Easy', 'Normal', 'Hard', 'Nightmare')),
    preferred_map  TEXT    NOT NULL DEFAULT 'Random',
    fps_limit      INTEGER NOT NULL DEFAULT 144
                   CHECK(fps_limit IN (0, 60, 144, 240, 360)),
    updated_at     DATETIME DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (id_user) REFERENCES users(id_user) ON DELETE CASCADE
);

INSERT OR IGNORE INTO user_settings (id_user)
SELECT id_user FROM users;</sql><current_tab id="0"/></tab_sql></sqlb_project>
